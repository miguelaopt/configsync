# ---------------------------------------------------------------------------
# ConfigSync — environment variables
# Copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (required).
# Matches docker-compose defaults: `docker compose up -d db`
DATABASE_URL=postgres://gsv:gsv@localhost:5432/gsv

# Secret used to sign sessions (required). Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string

# Public URL of this deployment (required). No trailing slash.
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public repository URL shown in the app footer / landing page (optional).
NEXT_PUBLIC_REPO_URL=

# --- Optional: GitHub OAuth sign-in ---------------------------------------
# Create an OAuth app at https://github.com/settings/developers with callback
#   <BETTER_AUTH_URL>/api/auth/callback/github
# Leave empty to hide the GitHub button.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Optional: transactional email (password reset) -----------------------
# When unset, reset links are printed to the server log instead of emailed.
# Any SMTP-compatible service works; see docs/self-hosting.md.
SMTP_URL=
EMAIL_FROM="ConfigSync <noreply@example.com>"

# --- Optional: AI screenshot assistant (not required for the core app) ----
# Providers are pluggable; see docs/architecture/ai-providers.md
# AI_VISION_PROVIDER=
# AI_VISION_API_KEY=
