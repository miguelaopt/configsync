# ---------------------------------------------------------------------------
# ConfigSync — environment variables
# Copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (required).
# Matches docker-compose defaults: `docker compose up -d db`
DATABASE_URL=postgres://gsv:gsv@localhost:5432/gsv

# Secret used to sign sessions (required). Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string

# Public URL of this deployment (required). No trailing slash.
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Production only (docker compose --profile app --profile proxy) --------
# Domain Caddy serves with automatic TLS; www.<domain> redirects to it. DNS A records must point here.
APP_DOMAIN=
# Postgres credentials for the compose db service. Bind the port to localhost on a public server.
POSTGRES_PASSWORD=gsv
POSTGRES_PORT=5432
# APP_PORT=3000

# --- Optional: GitHub OAuth sign-in ---------------------------------------
# Create an OAuth app at https://github.com/settings/developers with callback
#   <BETTER_AUTH_URL>/api/auth/callback/github
# Leave empty to hide the GitHub button.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Optional: transactional email (password reset) -----------------------
# When unset, reset links are printed to the server log instead of emailed.
# Any SMTP-compatible service works; see docs/self-hosting.md.
SMTP_URL=
EMAIL_FROM="ConfigSync <noreply@example.com>"

# --- Optional: Paddle billing (Free/Pro plans) ------------------------------
# Leave unset to run without plans: every account is Pro. See docs/billing.md.
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_MONTHLY=
PADDLE_PRICE_LIFETIME=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENV=sandbox

# --- Optional: AI screenshot importer (Pro) --------------------------------
# Reads screenshots of a game's settings menu and proposes values. Off when unset.
# Only "anthropic" ships; see docs/architecture/ai-providers.md
AI_VISION_PROVIDER=
AI_VISION_API_KEY=
# AI_VISION_MODEL=claude-opus-5

# Search engine ownership checks (optional; DNS verification works without these)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
